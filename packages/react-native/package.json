{
  "name": "@katalix/react-native",
  "version": "1.0.2",
  "description": "React Native renderer for Katalix semantic trees",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@katalix/core": "1.0.2",
    "@katalix/motion": "1.0.2",
    "@katalix/tokens": "1.0.2"
  },
  "devDependencies": {
    "@katalix/diagnostics": "1.0.2",
    "@katalix/dsl": "1.0.2",
    "@types/react": "~19.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-native": "0.79.7"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
