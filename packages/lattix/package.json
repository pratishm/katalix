{
  "name": "lattix",
  "version": "1.0.0",
  "description": "Umbrella package for the Lattix app framework and CLI",
  "type": "module",
  "bin": {
    "lattix": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@lattix/cli": "1.0.0",
    "@lattix/core": "1.0.0",
    "@lattix/diagnostics": "1.0.0",
    "@lattix/dsl": "1.0.0",
    "@lattix/motion": "1.0.0",
    "@lattix/patterns": "1.0.0",
    "@lattix/tokens": "1.0.0"
  },
  "peerDependencies": {
    "@lattix/app": "1.0.0",
    "@lattix/auth": "1.0.0",
    "@lattix/data": "1.0.0",
    "@lattix/native": "1.0.0",
    "@lattix/navigation": "1.0.0",
    "@lattix/react": "1.0.0",
    "@lattix/react-native": "1.0.0",
    "@lattix/storage": "1.0.0",
    "@lattix/web": "1.0.0"
  },
  "peerDependenciesMeta": {
    "@lattix/app": {
      "optional": true
    },
    "@lattix/auth": {
      "optional": true
    },
    "@lattix/data": {
      "optional": true
    },
    "@lattix/native": {
      "optional": true
    },
    "@lattix/navigation": {
      "optional": true
    },
    "@lattix/react": {
      "optional": true
    },
    "@lattix/react-native": {
      "optional": true
    },
    "@lattix/storage": {
      "optional": true
    },
    "@lattix/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
