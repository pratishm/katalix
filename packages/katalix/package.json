{
  "name": "katalix",
  "version": "2.0.0",
  "description": "Umbrella package for the Katalix app framework and CLI",
  "type": "module",
  "bin": {
    "katalix": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@katalix/cli": "2.0.0",
    "@katalix/core": "2.0.0",
    "@katalix/diagnostics": "2.0.0",
    "@katalix/dsl": "2.0.0",
    "@katalix/motion": "2.0.0",
    "@katalix/patterns": "2.0.0",
    "@katalix/tokens": "2.0.0"
  },
  "peerDependencies": {
    "@katalix/app": "2.0.0",
    "@katalix/auth": "2.0.0",
    "@katalix/data": "2.0.0",
    "@katalix/native": "2.0.0",
    "@katalix/navigation": "2.0.0",
    "@katalix/react": "2.0.0",
    "@katalix/react-native": "2.0.0",
    "@katalix/storage": "2.0.0",
    "@katalix/web": "2.0.0"
  },
  "peerDependenciesMeta": {
    "@katalix/app": {
      "optional": true
    },
    "@katalix/auth": {
      "optional": true
    },
    "@katalix/data": {
      "optional": true
    },
    "@katalix/native": {
      "optional": true
    },
    "@katalix/navigation": {
      "optional": true
    },
    "@katalix/react": {
      "optional": true
    },
    "@katalix/react-native": {
      "optional": true
    },
    "@katalix/storage": {
      "optional": true
    },
    "@katalix/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
