{
  "name": "@katalix/react",
  "version": "1.2.0",
  "description": "React web renderer for Katalix semantic trees",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@katalix/core": "1.2.0",
    "@katalix/motion": "1.2.0",
    "@katalix/tokens": "1.2.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@katalix/diagnostics": "1.2.0",
    "@katalix/dsl": "1.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
